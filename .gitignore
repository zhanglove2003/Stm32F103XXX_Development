# ------------------------------
# Keil MDK 工程专用忽略规则
# ------------------------------

# --- 工程文件与配置 ---
*.uvoptx       # 用户工程选项文件（本地调试配置）
*.uvguix.*     # 用户界面布局文件（窗口位置等）
*.bak          # 备份文件
*.crf          # 交叉引用文件（编译生成）
*.d            # 依赖文件（编译生成）

# --- 编译输出文件 ---
*.o            # 目标文件
*.obj          # 目标文件 (Windows风格)
*.axf          # ELF格式可执行文件（含调试信息）
*.hex          # HEX烧录文件
*.bin          # 二进制镜像文件
*.map          # 内存映射文件（链接生成）
*.lst          # 汇编列表文件
*.elf          # ELF格式文件

# --- 构建目录 ---
MDK-ARM/       # Keil默认构建输出目录
Objects/       # 自定义目标文件目录
Listings/      # 自定义列表文件目录

# --- 调试与临时文件 ---
*.ini          # 调试脚本（可能包含本地硬件配置）
*.log          # 编译日志文件
*.dbg          # 调试信息临时文件
*.cdb          # 调试配置数据库
*.tracespec    # Trace调试配置文件
JLinkLog.txt   # J-Link调试日志

# --- IDE自动生成文件 ---
*.uvmpw        # 多项目工作区文件
*.dep          # 旧版本依赖文件
*.plg          # 编译过程日志文件
*.jlink        # J-Link调试脚本

# --- 其他临时文件 ---
*.~*           # 编辑器临时文件
*.tmp          # 临时文件
build/         # 自定义构建目录